{
  // Run and debug configurations for VS Code, when you open this `flutter`
  // folder on its own. (Opening the repository's root folder works too, with
  // its own copy of these in ../.vscode/launch.json, plus the server.) Pick
  // one in the Run and Debug view (Ctrl/Cmd + Shift + D), then press F5.
  //
  // They need the Flutter extension (Dart-Code.flutter). VS Code offers to
  // install it when you open this folder (see extensions.json). Choose the
  // device (phone, emulator, desktop, or Chrome) in the status bar.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart"
    },
    {
      "name": "Flutter (profile mode)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      // Profile mode runs at release speed, but keeps DevTools.
      "flutterMode": "profile"
    },
    {
      "name": "Flutter (release mode)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "release"
    },
    {
      "name": "Flutter on Chrome",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome"
    },
    {
      "name": "Flutter tests",
      "type": "dart",
      "request": "launch",
      "program": "test/"
    }
  ]
}
